# ============================================================
# ASKQ environment configuration - TEMPLATE ONLY
# Copy to .env (same folder) and fill in real values:
#     Copy-Item .env.example .env
# .env is git-ignored. Never commit real secrets.
# ============================================================

# ---- Application (used from Phase 1) ----
# development | test | production. production refuses to start unless every
# secret below is set and CORS_ORIGINS is given explicitly; it also hides /docs.
APP_ENV=development
# Comma-separated browser origins allowed by CORS (scheme://host[:port]; never "*")
CORS_ORIGINS=http://localhost:5173

# ---- MySQL (used from Phase 2/3) ----
# Must stay 127.0.0.1: the ASKQ accounts exist only as 'askq_*'@'127.0.0.1'
# (not 'localhost', which may resolve to ::1 or a named pipe).
DB_HOST=127.0.0.1
DB_PORT=3306
# Organisational (university) data - queried read-only
DB_UNIVERSITY_NAME=askq_university
# ASKQ system data - history, conversations, CAIR ledger, evaluation runs
DB_SYSTEM_NAME=askq_system

# database\setup_db.ps1 creates both accounts with these passwords.
# Replace the placeholders with your own values: at least 16 characters, the two
# must differ, and use only  A-Z a-z 0-9 . _ ~ ! @ % ^ * + = : , -
# (No quotes, spaces, '#', '$' or backslashes, so every parser reads them the same.)
# The MySQL root password is never stored here; see database\README.md.

# Least-privilege account: SELECT only on the university database.
# All LLM-generated SQL runs through this account.
DB_READER_USER=askq_reader
DB_READER_PASSWORD=change-me-reader-password

# Application account: reads auth data, writes to the system database.
DB_APP_USER=askq_app
DB_APP_PASSWORD=change-me-app-password

# ---- Authentication (used from Phase 3) ----
# At least 32 characters. Until it is replaced, login and /me answer 503
# (there is no fallback secret). Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-long-random-secret
# HS256, HS384 or HS512
JWT_ALGORITHM=HS256
# Access-token lifetime, 1-1440 minutes
JWT_EXPIRE_MINUTES=60

# ---- SQL execution limits (used from Phase 4) ----
# Every executed SELECT is bounded to SQL_MAX_ROWS rows (1-10000) and stopped
# server-side after SQL_TIMEOUT_MS milliseconds (MySQL max_execution_time).
SQL_MAX_ROWS=500
SQL_TIMEOUT_MS=5000

# ---- SQL generation provider ----
# Which language model drafts the SQL: claude (Claude API, needs ANTHROPIC_API_KEY)
# or ollama (a local Ollama server, no key). The application default is claude;
# the local demo uses ollama. Either way the generated SQL is untrusted and goes
# through the same validation, RBAC/row scope, CAIR and reader-only execution.
LLM_PROVIDER=ollama

# ---- Ollama (LLM_PROVIDER=ollama) ----
# Install Ollama and pull the model first:  ollama pull qwen2.5-coder:7b
# scheme://host[:port] only (no path, no credentials). Keep it on 127.0.0.1:
# questions, conversation and the role's schema are sent to this server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# A local 7B model can be slow (it may also have to load first): 5-600 seconds
OLLAMA_TIMEOUT_SECONDS=120
# Context window in tokens (>= 4096). The prompt alone is ~2.4k tokens and
# Ollama silently truncates anything beyond the window, so do not lower it.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0
# Optional (default shown): upper bound on generated tokens
# OLLAMA_MAX_TOKENS=2048

# ---- Claude API (used from Phase 4; LLM_PROVIDER=claude) ----
# With LLM_PROVIDER=claude and no real key, POST /api/v1/query answers 503.
# Not needed (and not required in production) with LLM_PROVIDER=ollama.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Any model id your Anthropic account can use (see Anthropic's model list).
# The default, claude-sonnet-5, is a legacy model (still available; Anthropic's
# docs, checked 2026-10-27); claude-sonnet-5-5 is the current Sonnet.
ANTHROPIC_MODEL=claude-sonnet-5
# Optional tuning (defaults shown)
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_TIMEOUT_SECONDS=60
# ANTHROPIC_MAX_RETRIES=1
# Earlier turns of a conversation shown to the model for follow-up questions
# QUERY_CONTEXT_TURNS=5

# ---- CAIR (used from Phase 5) ----
# false switches off the aggregate-only statistical tier (it is only safe behind CAIR).
CAIR_ENABLED=true
# Optional tuning (defaults shown; see docs/cair.md)
# CAIR_MIN_GROUP_SIZE=5
# CAIR_TRIGGER_THRESHOLD=0.5
# CAIR_WINDOW_QUERIES=20
# CAIR_WINDOW_HOURS=24
# CAIR_REFUSAL_PROBE_LIMIT=3
# CAIR_POPULATION_CAP=20000
