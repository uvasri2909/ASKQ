# ============================================================
# ASKQ environment configuration - TEMPLATE ONLY
# Copy to .env (same folder) and fill in real values:
#     Copy-Item .env.example .env
# .env is git-ignored. Never commit real secrets.
# ============================================================

# ---- Application (used from Phase 1) ----
APP_ENV=development
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# ---- MySQL (used from Phase 2/3) ----
# Must stay 127.0.0.1: the ASKQ accounts exist only as 'askq_*'@'127.0.0.1'
# (not 'localhost', which may resolve to ::1 or a named pipe).
DB_HOST=127.0.0.1
DB_PORT=3306
# Organisational (university) data - queried read-only
DB_UNIVERSITY_NAME=askq_university
# ASKQ system data - history, conversations, CAIR ledger, evaluation runs
DB_SYSTEM_NAME=askq_system

# database\setup_db.ps1 creates both accounts with these passwords.
# Replace the placeholders with your own values: at least 16 characters, the two
# must differ, and use only  A-Z a-z 0-9 . _ ~ ! @ % ^ * + = : , -
# (No quotes, spaces, '#', '$' or backslashes, so every parser reads them the same.)
# The MySQL root password is never stored here; see database\README.md.

# Least-privilege account: SELECT only on the university database.
# All LLM-generated SQL runs through this account.
DB_READER_USER=askq_reader
DB_READER_PASSWORD=change-me-reader-password

# Application account: reads auth data, writes to the system database.
DB_APP_USER=askq_app
DB_APP_PASSWORD=change-me-app-password

# ---- Authentication (used from Phase 4) ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- SQL execution limits (used from Phase 5) ----
SQL_MAX_ROWS=500
SQL_TIMEOUT_MS=5000

# ---- Claude API (used from Phase 6) ----
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# ---- CAIR (used from Phase 8/9) ----
CAIR_ENABLED=true
